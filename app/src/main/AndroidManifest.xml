<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        Outbound IMAP / POP3 / SMTP connections to the mail servers a script names (roadmap D13 / D24).
        The plugin opens no other connections, hosts no listener, and asks for no storage permission.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Background watches (roadmap P8, D40): MailWatchService keeps the IDLE / polling connections of
        the watches configured in the settings page while no script runs. It is a foreground service of
        type specialUse (the dataSync type is capped at six hours a day and cannot start from
        BOOT_COMPLETED on Android 15); its persistent notification needs POST_NOTIFICATIONS on
        Android 13 and later (asked when the first watch is enabled; the service runs without it);
        RECEIVE_BOOT_COMPLETED backs the opt-in "start after boot" switch, whose receiver stays
        disabled until the user turns it on. None of these run unless a watch is configured.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Backs the battery-optimization guide row of the settings page only (roadmap P4.6, D27): the row
        shows PowerManager.isIgnoringBatteryOptimizations and, when the user asks, opens the system
        dialog. Nothing is requested on start and no feature depends on the exclusion. The BatteryLife
        lint note concerns store policy; this plugin is sideloaded through the AutoJs6 plugin center.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <queries>
        <package android:name="org.autojs.autojs6" />
    </queries>

    <!--
        android:usesCleartextTraffic keeps its default (false). Mail sessions use TLS unless a script
        explicitly asks for tls: 'none'; that choice is made at the socket layer by the mail core and
        is not governed by the network security policy, which only covers platform HTTP stacks. The
        plugin's only HTTP client is oauth.HttpsFormPoster (roadmap P9): HTTPS POSTs to the OAuth 2.0
        token endpoints of Google and Microsoft during a browser sign-in and a token refresh, nothing else.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        tools:targetApi="33">

        <meta-data
            android:name="org.autojs.plugin.contract.NATIVE_PAGE_ALIGNMENT"
            android:value="0" />

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />

        <!--
            The settings screens (roadmap P4.2). AccountsActivity is the launcher entry; the editor,
            the application settings and the about screen chain back to it through parentActivityName.
        -->
        <activity
            android:name=".settings.AccountsActivity"
            android:exported="true"
            android:label="@string/accounts_title"
            android:theme="@style/Theme.AngusMail">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.AccountEditorActivity"
            android:exported="false"
            android:label="@string/editor_title_add"
            android:parentActivityName=".settings.AccountsActivity"
            android:theme="@style/Theme.AngusMail"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AppSettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".settings.AccountsActivity"
            android:theme="@style/Theme.AngusMail" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/about_title"
            android:parentActivityName=".AppSettingsActivity"
            android:theme="@style/Theme.AngusMail" />

        <activity
            android:name=".ReleaseHistoryActivity"
            android:exported="false"
            android:label="@string/release_history_title"
            android:parentActivityName=".AppSettingsActivity"
            android:theme="@style/Theme.AngusMail" />

        <!-- Background watches (roadmap P8): the list and the editor, reached from the application settings. -->
        <activity
            android:name=".trigger.WatchesActivity"
            android:exported="false"
            android:label="@string/watches_title"
            android:parentActivityName=".AppSettingsActivity"
            android:theme="@style/Theme.AngusMail" />

        <activity
            android:name=".trigger.WatchEditorActivity"
            android:exported="false"
            android:label="@string/watch_editor_title_add"
            android:parentActivityName=".trigger.WatchesActivity"
            android:theme="@style/Theme.AngusMail"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The browser sign-in (roadmap P9): the waiting screen below the Custom Tab, reached from the
            account editor, and the landing point the browser delivers the redirect URI to. The landing
            activity must be exported without a permission (the browser starts it); it only forwards the
            URI to the waiting screen, which checks the request's state before anything else happens.
            The redirect schemes are the application id (Microsoft) and Google's reversed client id
            (the oauthGoogleScheme placeholder of the build; a placeholder value when no Google client
            is configured).
        -->
        <activity
            android:name=".oauth.OAuthSignInActivity"
            android:exported="false"
            android:label="@string/oauth_title"
            android:launchMode="singleTop"
            android:parentActivityName=".settings.AccountEditorActivity"
            android:theme="@style/Theme.AngusMail" />

        <activity
            android:name=".oauth.OAuthRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth2"
                    android:path="/microsoft"
                    android:scheme="${applicationId}" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- scheme only: the reversed-client-id redirect has no authority, and Android matches a path only with a host -->
                <data android:scheme="${oauthGoogleScheme}" />
            </intent-filter>
        </activity>

        <!--
            Parameterless settings entry for the host (roadmap P4.3): forwards to AccountsActivity and
            finishes. It carries the plugin permission so only AutoJs6 can start it, which is why the
            launcher entry above does not: a permission there would hide the icon from the launcher.
        -->
        <activity
            android:name=".MailSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.MAIL_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AngusMailPluginInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="mail" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5282" />
        </service>

        <service
            android:name=".AngusMailPluginService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.MAIL" />
                <category android:name="mail" />
            </intent-filter>
            <meta-data
                android:name="requiresHostVersion"
                android:value="5282" />
        </service>

        <!--
            The foreground service of the background watches (roadmap P8, D40). Not exported: the
            settings page, the boot receiver and the plugin's own Binder start it. The special-use
            subtype names the reason for Android 14 and later.
        -->
        <service
            android:name=".trigger.MailWatchService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="mail_background_watch" />
        </service>

        <!--
            Restarts the enabled watches after a boot; disabled here and switched on only by the
            "start after boot" switch of the watches page (through the package manager).
        -->
        <receiver
            android:name=".trigger.BootReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            AppCompat / Material pull in auto-start components; this plugin exposes no provider and, apart
            from the boot receiver above, no receiver (ManifestContractTest and the installed-package
            contract test enforce it).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

    </application>

</manifest>
